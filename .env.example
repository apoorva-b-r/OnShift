# ==================================================
# ONSHIFT MONOREPO ENVIRONMENT VARIABLES (.env.example)
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS
# ==================================================

# MONGODB DATABASE CONFIGURATION
# MongoDB Atlas Connection String Format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/onshift?retryWrites=true&w=majority
# Local Fallback:
MONGODB_URI=mongodb://localhost:27017/onshift

# BACKEND SERVICE (NODE.JS / EXPRESS)
PORT=4000
NODE_ENV=development
VERIFICATION_ENGINE_URL=http://localhost:8000
ISSUER_NAME=OnShift Proof Authority

# VERIFICATION ENGINE SERVICE (PYTHON / FASTAPI)
ENGINE_PORT=8000
ENGINE_HOST=0.0.0.0

# DEMO CRYPTOGRAPHIC KEYS (DEVELOPMENT ONLY)
# DO NOT USE THESE KEYS IN PRODUCTION
ED25519_PRIVATE_KEY_HEX=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60
ED25519_PUBLIC_KEY_HEX=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a

# WEB VERIFIER (REACT / VITE)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEFAULT_ISSUER_PUBLIC_KEY=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
