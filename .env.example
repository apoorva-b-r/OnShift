# ==================================================
# ONSHIFT MONOREPO ENVIRONMENT VARIABLES
# ==================================================

# MONGODB DATABASE CONFIGURATION
MONGODB_URI=mongodb://localhost:27017/onshift

# BACKEND SERVICE (NODE.JS / EXPRESS)
PORT=4000
NODE_ENV=development
VERIFICATION_ENGINE_URL=http://localhost:8000
ISSUER_NAME=OnShift Proof Authority

# AUTHENTICATION
# WARNING: Replace this with a long, random secret in any non-development environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=onshift_default_jwt_secret_key_2026_dev_demo_only
# Set to 'true' to enforce JWT authentication on protected routes.
# Leave as 'false' only during local development / demo mode.
ENABLE_AUTH=false

# NEMOTRON ULTRA 3 AI KEY (NVIDIA BUILD API)
# Paste your API key from https://build.nvidia.com below:
# DEMO CRYPTOGRAPHIC KEYS (DEVELOPMENT ONLY)
# Never commit real API keys or private keys. Set these only in the runtime environment.
NEMOTRON_API_KEY=
ED25519_PRIVATE_KEY_HEX=
ED25519_PUBLIC_KEY_HEX=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a

# WEB VERIFIER (REACT / VITE)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEFAULT_ISSUER_PUBLIC_KEY=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
VITE_ONSHIFT_ISSUER=OnShift Proof Authority
VITE_ONSHIFT_ISSUER_PUBLIC_KEY=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a

# VERIFICATION DEMO MODE
# Must remain false in production. Enables fixture fallback only for local demos.
ONSHIFT_DEMO_MODE=false