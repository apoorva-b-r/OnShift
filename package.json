{
  "name": "onshift-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OnShift - Portable Proof of Work & Income for the Gig Workforce",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:dev": "node scripts/start-dev.js",
    "seed:demo": "node scripts/seed-demo-data.js",
    "reset:demo": "node scripts/reset-demo.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm --prefix apps/backend run test",
    "test:engine": "cd apps/verification-engine && pytest",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:identity-demo": "npm --prefix apps/identity-demo run dev",
    "dev:web": "npm --prefix apps/verifier-web run dev",
    "dev:engine": "cd apps/verification-engine && uvicorn app.main:app --reload --port 8000"
  },
  "keywords": [
    "gig-economy",
    "proof-of-income",
    "financial-inclusion",
    "ed25519",
    "privacy-first"
  ],
  "author": "OnShift Hackathon Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
