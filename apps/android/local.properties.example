## OnShift Android - Local Configuration Template
# Copy this file to local.properties or edit local.properties directly.
# local.properties is gitignored so your personal IP/SDK path will not be committed to GitHub.

# Android SDK Location (managed by Android Studio)
# sdk.dir=C\:\\Users\\<username>\\AppData\\Local\\Android\\Sdk

# Development Backend URL:
# - For Android Emulator: http://10.0.2.2:4000/api/v1
# - For Physical Device: http://<YOUR_LAPTOP_LAN_IP>:4000/api/v1 (e.g. http://192.168.1.50:4000/api/v1)
BACKEND_BASE_URL=http://10.0.2.2:4000/api/v1
